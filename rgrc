# rgs / ripgrep の既定オプション
#   * 1 行 1 引数。値を取るものは --opt=value の形で書く（スペース区切り不可）
#   * コマンドラインで指定したほうが優先される
#   * 行頭 # はコメント

# 検索語が全部小文字なら大文字小文字を区別しない
--smart-case

# 長すぎる行は切り詰める（圧縮ファイル等でエディタが固まるのを防ぐ）
--max-columns=500
--max-columns-preview

# 除外したいもの
--glob=!.git/*
--glob=!node_modules/*
--glob=!*.min.js

# 隠しファイルも検索したいなら次を有効化
#--hidden
